rules_version = '2';

// ============================================================================
// LDSDM — Corrected Firestore Rules
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isAuthenticated() {
      return request.auth != null;
    }

    // Owner = super_admin. The null guard keeps anonymous requests denied
    // instead of erroring on request.auth.token.
    function isSuperAdmin() {
      return request.auth != null
        && request.auth.token.email.lower() == 'mehedihasansagor26@gmail.com';
    }

    // ---------- public portal (no login needed) ----------
    match /institution/public_portal {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isSuperAdmin();
    }

    // ---------- full store ----------
    match /institution/main_store {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isSuperAdmin();
    }

    // ---------- admin marker documents ----------
    match /admins/{uid} {
      allow read: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == uid);
      allow create, update: if isAuthenticated() && request.auth.uid == uid;
      allow delete: if isSuperAdmin();
    }

    // ---------- RBAC: members + roles ----------
    match /institutions/{institutionId}/{document=**} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isSuperAdmin();
    }

    // ---------- cloud backup snapshots ----------
    match /cloud_snapshots/{snapshotId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ---------- platform audit log (append-only) ----------
    match /platformAuditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // ---------- everything else: denied ----------
    match /{document=**} {
      allow read, create, update, delete: if false;
    }
  }
}
