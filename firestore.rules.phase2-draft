rules_version = '2';

// ============================================================================
// PHASE 2 DRAFT — DO NOT PUBLISH until the rollout steps below are done.
// ============================================================================
// Goal: lock `institution/main_store` (the full store: fees, transactions,
// staff, users/RBAC, settings) behind login, while the public portal keeps
// working from the derived, public-safe `institution/public_portal` doc.
//
// PUBLISH ORDER (must follow exactly):
//   1. Deploy the Phase 2 code first (AppContext reads public_portal for
//      anonymous visitors and creates it on every signed-in sync).
//   2. Sign in once as an admin/teacher and let the app sync (or use
//      "Force Push") so `institution/public_portal` is CREATED.
//   3. Open the site in a logged-out / private browser window and verify:
//      landing page loads, "View Results" search works, and a student
//      profile opens by Student ID — exactly as before.
//   4. ONLY THEN publish these rules in the Firebase Console
//      (Firestore Database -> database
//       `ai-studio-remixmadrashares-c9cf5740-6efd-4d02-8af4-293ed58abf4b`
//       -> Rules tab).
//   5. Re-verify step 3 after publishing.
//
// Rollback: re-publish the previous rules (read public / write auth-only)
// at any time; the Phase 2 code falls back to main_store automatically
// whenever public_portal is missing or unreadable.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Public portal subset — derived by the app from main_store and
    // containing ONLY fields the logged-out portal displays (published
    // results + public student-profile fields). Anyone may read it;
    // only signed-in users (the app, while syncing) may write it.
    match /institution/public_portal {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // The full store — signed-in users only, for both reads and writes.
    match /institution/main_store {
      allow read, write: if request.auth != null;
    }

    // Admin marker documents written by the app for signed-in admins.
    match /admins/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // RBAC data the signed-in app reads on every login (institution
    // members + custom roles, services/rbac.ts). Signed-in only — a
    // default-deny here would break staff login/role loading.
    match /institutions/{institutionId}/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Cloud backup snapshots (signed-in backup/restore features only).
    match /cloud_snapshots/{snapshotId} {
      allow read, write: if request.auth != null;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
